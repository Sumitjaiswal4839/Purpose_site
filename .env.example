# ========== DATABASE (Neon PostgreSQL) ==========
DATABASE_URL="postgresql://neondb_owner:password@ep-lucky-boat-xxx.aws.neon.tech/neondb?channel_binding=require&sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://neondb_owner:password@ep-lucky-boat-xxx.aws.neon.tech/neondb?channel_binding=require&sslmode=require"
NEON_BRANCH=production

# ========== APP & AUTH CONFIGURATION ==========
NEXT_PUBLIC_APP_URL="https://yourdomain.com"
NODE_ENV="production"
JWT_SECRET="your-32-byte-or-longer-secret"
ENCRYPTION_SECRET_KEY="your-32-character-secret-key"
VERIFY_EMAIL_SECRET="your-verify-email-secret"

# ========== ADMIN CREDENTIALS ==========
ADMIN_USERNAME="Purpose@Purpose"
ADMIN_PASSWORD="YourAdminPassword"

# ========== EMAIL SERVICE (Gmail) ==========
GMAIL_USER="your-email@gmail.com"
GMAIL_PASS="your-gmail-app-password"

# ========== PAYMENT CONFIGURATION ==========
UPI_QR_CODE_PATH="/public/upi-qr.png"

# ========== CLOUDINARY MEDIA STORAGE ==========
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"
