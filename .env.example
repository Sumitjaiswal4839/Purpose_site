# ── Database (SQLite for local demo — zero setup needed) ──
DATABASE_URL="file:./database/purpose.db"

# ── Redis (optional, leave blank to disable caching) ──
REDIS_URL=

# ── App URL ──
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# ── Security (generate your own random strings) ──
ENCRYPTION_SECRET_KEY="replace_with_random_32_char_string"
ENCRYPTION_SALT="replace_with_random_32_char_string"
JWT_SECRET="replace_with_random_32_char_string"
VERIFY_EMAIL_SECRET="replace_with_random_32_char_string"

# ── Email (Gmail App Password — not your real password) ──
GMAIL_USER="your_email@gmail.com"
GMAIL_PASS="your_gmail_app_password"

# ── Cloudinary (image uploads) ──
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ── Manual UPI Payment ──
UPI_QR_CODE_PATH="/upi-qr.png"

# ── Admin Login (change before demo) ──
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change_this_password"
